---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const links = await getCollection("links");

const categories = new Map<
  string,
  { title: string; url: string; description: string }[]
>();

for (const link of links) {
  const cat = link.data.category;
  if (!categories.has(cat)) {
    categories.set(cat, []);
  }
  categories.get(cat)!.push({
    title: link.data.title,
    url: link.data.url,
    description: link.data.description,
  });
}

const sortedCategories = [...categories.entries()].sort((a, b) =>
  a[0].localeCompare(b[0])
);
---

<Layout title="Home">
  <section class="hero">
    <h1>Site Links</h1>
    <p>A curated collection of useful websites for developers</p>
  </section>

  {
    sortedCategories.map(([category, items], i) => (
      <section class="category-section">
        <h2 class="category-heading">
          <span class="category-dot"></span>
          {category}
          <span class="category-count">{items.length}</span>
        </h2>
        <div class="link-grid">
          {items.map((item) => (
            <a
              href={item.url}
              class="link-card"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="link-favicon">
                <img
                  src={`https://www.google.com/s2/favicons?domain=${new URL(item.url).hostname}&sz=32`}
                  alt=""
                  width="16"
                  height="16"
                  loading="lazy"
                  onerror="this.style.display='none'"
                />
              </span>
              <div class="link-body">
                <span class="link-title">{item.title}</span>
                <span class="link-desc">{item.description}</span>
              </div>
              <svg class="link-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="7" y1="17" x2="17" y2="7"/>
                <polyline points="7 7 17 7 17 17"/>
              </svg>
            </a>
          ))}
        </div>
      </section>
    ))
  }
</Layout>
